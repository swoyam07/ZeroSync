<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Gallery: read-only video access. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- Gallery: keep the CPU awake so video sound continues while the screen is locked. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Music: read songs (WAKE_LOCK above also keeps music playing with the screen off). -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- Camera: passport / ID / PDF capture. Files stay private until the user makes one public. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Files: find PDF / Word / PowerPoint / Excel anywhere on the phone (read-only use).
         User turns it on in Settings ("All files access"); approved 2026-10-21. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Phone (default Phone app role): place calls, show the incoming-call screen. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Recents: read the phone's own call history (read-only). -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Offline by design: strip network permissions even if a library adds them.
         Without INTERNET, Android blocks every network socket for this app. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZeroSync">

        <!-- Exported only because the launcher must start it. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phone: the next three are exported only because Android requires them for the
             default Phone app role (allowed by the project rules). -->
        <activity
            android:name=".phone.DialerActivity"
            android:exported="true"
            android:taskAffinity=".dialer">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <!-- Call screen: over the lock screen, turns the screen on. Not exported. -->
        <activity
            android:name=".phone.CallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity=".call"
            android:turnScreenOn="true" />

        <!-- Missed calls: the system sends them here instead of showing its own notification. -->
        <receiver
            android:name=".phone.MissedCallReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.action.SHOW_MISSED_CALLS_NOTIFICATION" />
            </intent-filter>
        </receiver>
        <!-- Call back / dismiss buttons of our own notification (not exported). -->
        <receiver
            android:name=".phone.MissedCallActionReceiver"
            android:exported="false" />

        <!-- Decline button on the small incoming-call pop-up (not exported). -->
        <receiver
            android:name=".phone.DeclineReceiver"
            android:exported="false" />

        <!-- Android's call bridge; only the system can bind it (BIND_INCALL_SERVICE). -->
        <service
            android:name=".phone.CallService"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>
    </application>
</manifest>
