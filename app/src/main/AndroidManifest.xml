<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Gallery: read-only video access. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- Gallery: keep the CPU awake so video sound continues while the screen is locked. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Music: read songs (WAKE_LOCK above also keeps music playing with the screen off). -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- Camera: passport / ID / PDF capture. Files stay private until the user makes one public. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Files: find PDF / Word / PowerPoint / Excel anywhere on the phone (read-only use).
         User turns it on in Settings ("All files access"); approved 2026-10-21. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Phone (default Phone app role): place calls, show the incoming-call screen. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Recents: read the phone's own call history (read-only). -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Phone: vibrate while a call rings (always). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- ZeroSync's own small incoming-call card over other apps (phone unlocked). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Messages (default SMS app, text only). SMS goes over the SIM, not the internet. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Alarms (user-approved): exact alarm-clock times, re-set after restart, ring in a short
         foreground service while sounding. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />

    <!-- Offline by design: strip network permissions even if a library adds them.
         Without INTERNET, Android blocks every network socket for this app. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZeroSync">

        <!-- Exported only because the launcher must start it. -->
        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phone: the next three are exported only because Android requires them for the
             default Phone app role (allowed by the project rules). -->
        <activity
            android:name=".phone.DialerActivity"
            android:screenOrientation="portrait"
            android:exported="true"
            android:taskAffinity=".dialer">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <!-- Call screen: over the lock screen, turns the screen on. Not exported. -->
        <activity
            android:name=".phone.CallActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity=".call"
            android:turnScreenOn="true" />

        <!-- Missed calls: the system sends them here instead of showing its own notification. -->
        <receiver
            android:name=".phone.MissedCallReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.action.SHOW_MISSED_CALLS_NOTIFICATION" />
            </intent-filter>
        </receiver>
        <!-- Call back / dismiss buttons of our own notification (not exported). -->
        <receiver
            android:name=".phone.MissedCallActionReceiver"
            android:exported="false" />

        <!-- Decline button on the small incoming-call pop-up (not exported). -->
        <receiver
            android:name=".phone.DeclineReceiver"
            android:exported="false" />

        <!-- Spam: Android asks this before a call rings; spam numbers are rejected silently. -->
        <service
            android:name=".phone.SpamScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- Messages: everything Android requires from a default SMS app. Each exported part is
             protected by a permission only the system holds. -->
        <activity
            android:name=".sms.MessagesActivity"
            android:screenOrientation="portrait"
            android:exported="true"
            android:taskAffinity=".messages"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".sms.SmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".sms.MmsWapPushReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".sms.SmsSentReceiver"
            android:exported="false" />
        <service
            android:name=".sms.HeadlessSmsSendService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>

        <!-- Alarms: Time screen, full-screen ringing screen, ringing service, restart re-scheduler.
             None exported (system boot broadcasts still reach the receiver). -->
        <activity
            android:name=".alarm.TimeActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:taskAffinity=".time" />
        <activity
            android:name=".alarm.AlarmActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity=".alarmring"
            android:turnScreenOn="true" />
        <service
            android:name=".alarm.AlarmService"
            android:exported="false"
            android:foregroundServiceType="systemExempted" />
        <!-- Calendar: shows the fixed event reminder and handles its Done button (not exported). -->
        <receiver
            android:name=".calendar.EventReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".alarm.AlarmBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Android's call bridge; only the system can bind it (BIND_INCALL_SERVICE). -->
        <service
            android:name=".phone.CallService"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <!-- ZeroSync plays the ringtone itself (per-category ringtones). -->
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_RINGING"
                android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>
    </application>
</manifest>
